[Unit]
Description=HDHomeRun discovery relay (no video proxy)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/data/hdhr-discovery/config
ExecStartPre=/data/hdhr-discovery/firewall.sh start
ExecStart=/usr/bin/python3 -u /data/hdhr-discovery/relay.py --interface ${INTERFACE} --network ${NETWORK} --gateway ${GATEWAY} --tuner ${TUNER}
ExecStopPost=/data/hdhr-discovery/firewall.sh stop
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
